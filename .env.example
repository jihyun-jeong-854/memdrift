# Copy to .env and fill in only the keys for the providers you plan to use.

# --- benchmark construction + scoring (Claude) -------------------------------
# scenario_creation/* and drift_scoring/judge_drift.py
ANTHROPIC_API_KEY=

# --- target models -----------------------------------------------------------
# drift_inference --provider openai (gpt-5.x), the gpt-5.2 construction target,
# the gpt-4.1 neutral-conversation simulator, mem0's extraction LLM and
# embedder, and SimpleMem's compression LLM
OPENAI_API_KEY=

# drift_inference --provider togetherai  (open-weight models)
TOGETHER_API_KEY=

# drift_inference --provider openrouter  (Gemini, Minimax, ...)
OPENROUTER_API_KEY=

# --- optional overrides ------------------------------------------------------
# MEMDRIFT_DATA=/abs/path/to/data
# MEMDRIFT_RESULTS=/abs/path/to/results
# MEMDRIFT_SIMPLEMEM_PATH=/abs/path/to/Memory/SimpleMem   # must end in Memory/SimpleMem
# MEMDRIFT_SCRATCH=/abs/path/for/qdrant-and-lancedb
# MEMDRIFT_HF_REPO=jhjeong99/memdrift
# MEMDRIFT_JUDGE_MODEL=claude-sonnet-4-5-20250929
# MEMDRIFT_CONSTRUCTION_MODEL=gpt-5.2
# MEMDRIFT_MEM0_LLM=gpt-5-mini
# MEMDRIFT_NEUTRAL_CONV_MODEL=gpt-4.1
